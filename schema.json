{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Schema for CodeTour tour files",
  "type": "object",
  "required": ["title", "steps"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Schema used to validate this tour file."
    },
    "title": {
      "type": "string",
      "description": "Specifies the title of the code tour."
    },
    "description": {
      "type": "string",
      "description": "Specifies an optional description for the code tour."
    },
    "ref": {
      "type": "string",
      "description": "Indicates the git ref that this tour is associated with."
    },
    "isPrimary": {
      "type": "boolean",
      "description": "Specifies whether the tour represents the primary tour for this codebase."
    },
    "steps": {
      "type": "array",
      "description": "Specifies the ordered steps in the code tour.",
      "default": [],
      "items": {
        "$ref": "#/definitions/step"
      }
    },
    "stepMarker": {
      "type": "string",
      "description": "Specifies the marker that associates source lines with tour steps."
    },
    "nextTour": {
      "type": "string",
      "description": "Specifies the title of the tour that follows this tour."
    },
    "when": {
      "type": "string",
      "description": "Specifies the condition that must be met before this tour is shown."
    }
  },
  "definitions": {
    "position": {
      "type": "object",
      "required": ["line", "character"],
      "properties": {
        "line": {
          "type": "number",
          "minimum": 1,
          "description": "One-based line number."
        },
        "character": {
          "type": "number",
          "minimum": 1,
          "description": "One-based column number."
        }
      }
    },
    "selection": {
      "type": "object",
      "required": ["start", "end"],
      "description": "Legacy text selection associated with a step.",
      "properties": {
        "start": {
          "$ref": "#/definitions/position"
        },
        "end": {
          "$ref": "#/definitions/position"
        }
      }
    },
    "symbolPathSegment": {
      "type": "object",
      "required": ["name", "kind"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Symbol name reported by the document symbol provider."
        },
        "kind": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "description": "VS Code SymbolKind value."
        }
      }
    },
    "anchor": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "path"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "symbol"
            },
            "path": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/symbolPathSegment"
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "text"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "content"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "description": "Literal selected source text, normalized to LF line endings."
            }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "file": {
          "type": "string",
          "description": "Workspace-relative source file associated with the step."
        },
        "directory": {
          "type": "string",
          "description": "Workspace-relative directory associated with the step."
        },
        "contents": {
          "type": "string",
          "description": "Embedded file contents associated with the step."
        },
        "view": {
          "type": "string",
          "minLength": 1,
          "description": "View ID associated with the step."
        },
        "uri": {
          "type": "string",
          "description": "Absolute URI associated with the step."
        },
        "line": {
          "type": "number",
          "minimum": 1,
          "description": "Legacy one-based line number associated with the step."
        },
        "pattern": {
          "type": "string",
          "description": "Legacy regular expression used when line is absent."
        },
        "selection": {
          "$ref": "#/definitions/selection"
        },
        "anchor": {
          "$ref": "#/definitions/anchor"
        },
        "title": {
          "type": "string",
          "description": "Optional title for the step."
        },
        "icon": {
          "type": "string",
          "description": "Optional icon for the step."
        },
        "description": {
          "type": "string",
          "description": "Description of the step."
        },
        "commands": {
          "type": "array",
          "description": "Command URIs executed when the step is opened.",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
