{
  "name": "better-codetour",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "publisher": "ElluIFX",
  "version": "0.2.0",
  "author": {
    "name": "ElluIFX",
    "url": "https://github.com/ElluIFX"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ElluIFX/better-codetour"
  },
  "bugs": {
    "url": "https://github.com/ElluIFX/better-codetour/issues"
  },
  "homepage": "https://github.com/ElluIFX/better-codetour#readme",
  "license": "MIT",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.73.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "Collaboration",
    "Sharing"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onNotebook:codetour"
  ],
  "main": "./dist/extension-node.js",
  "browser": "./dist/extension-web.js",
  "l10n": "./l10n",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "%configuration.title%",
      "properties": {
        "codetour.promptForWorkspaceTours": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.promptForWorkspaceTours%"
        },
        "codetour.showMarkers": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.showMarkers%"
        },
        "codetour.customTourDirectory": {
          "type": "string",
          "default": null,
          "description": "%configuration.customTourDirectory%"
        },
        "codetour.autoUpdateAnchors": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.autoUpdateAnchors%"
        }
      }
    },
    "commands": [
      {
        "command": "codetour.addContentStep",
        "title": "%command.addTourStep%",
        "category": "CodeTour"
      },
      {
        "command": "codetour.addDirectoryStep",
        "title": "%command.addTourStep%"
      },
      {
        "command": "codetour.addSelectionStep",
        "title": "%command.addContentMatchStep%"
      },
      {
        "command": "codetour.addSymbolStep",
        "title": "%command.addSymbolStep%"
      },
      {
        "command": "codetour.addTourStep",
        "title": "%command.addTourStep%"
      },
      {
        "command": "codetour.changeTourDescription",
        "title": "%command.changeDescription%"
      },
      {
        "command": "codetour.changeTourRef",
        "title": "%command.changeGitRef%"
      },
      {
        "command": "codetour.changeTourStepLine",
        "title": "%command.changeLine%"
      },
      {
        "command": "codetour.changeTourStepTitle",
        "title": "%command.changeTitle%"
      },
      {
        "command": "codetour.changeTourStepIcon",
        "title": "%command.changeIcon%"
      },
      {
        "command": "codetour.changeTourTitle",
        "title": "%command.changeTitle%"
      },
      {
        "command": "codetour.resetProgress",
        "title": "%command.resetProgress%",
        "category": "CodeTour"
      },
      {
        "command": "codetour.resetTourProgress",
        "title": "%command.resetProgress%"
      },
      {
        "command": "codetour.deleteTourStep",
        "title": "%command.deleteStep%"
      },
      {
        "command": "codetour.deleteTour",
        "title": "%command.deleteTour%"
      },
      {
        "command": "codetour.editTourAtStep",
        "title": "%command.editStep%"
      },
      {
        "command": "codetour.rebindTourStepAnchor",
        "title": "%command.rebindTourStepAnchor%",
        "icon": "$(link)"
      },
      {
        "command": "codetour.confirmAnchorRebind",
        "title": "%command.confirmAnchorRebind%",
        "icon": "$(check)"
      },
      {
        "command": "codetour.cancelAnchorRebind",
        "title": "%command.cancelAnchorRebind%",
        "icon": "$(close)"
      },
      {
        "command": "codetour.editTour",
        "title": "%command.editTour%",
        "category": "CodeTour",
        "icon": "$(edit)"
      },
      {
        "command": "codetour.endTour",
        "title": "%command.endTour%",
        "category": "CodeTour",
        "icon": "$(primitive-square)"
      },
      {
        "command": "codetour.exportTour",
        "title": "%command.exportTour%"
      },
      {
        "command": "codetour.hideMarkers",
        "title": "%command.hideMarkers%",
        "category": "CodeTour",
        "icon": "$(eye-closed)"
      },
      {
        "command": "codetour.makeTourPrimary",
        "title": "%command.makePrimary%"
      },
      {
        "command": "codetour.moveTourStepForward",
        "title": "%command.moveDown%",
        "icon": "$(arrow-down)"
      },
      {
        "command": "codetour.moveTourStepBack",
        "title": "%command.moveUp%",
        "icon": "$(arrow-up)"
      },
      {
        "command": "codetour.nextTourStep",
        "title": "%command.next%",
        "icon": "$(arrow-right)"
      },
      {
        "command": "codetour.openTourFile",
        "title": "%command.openTourFile%",
        "icon": "$(folder-opened)",
        "category": "CodeTour"
      },
      {
        "command": "codetour.openTourUrl",
        "title": "%command.openTourUrl%",
        "category": "CodeTour"
      },
      {
        "command": "codetour.openCodeTourPanel",
        "title": "%command.openCodeTourPanel%",
        "category": "CodeTour",
        "icon": "$(list-tree)"
      },
      {
        "command": "codetour.refreshTours",
        "title": "%command.refreshTours%",
        "category": "CodeTour",
        "icon": "$(refresh)"
      },
      {
        "command": "codetour.previewTour",
        "title": "%command.previewTour%",
        "icon": "$(preview)"
      },
      {
        "command": "codetour.previousTourStep",
        "title": "%command.previous%",
        "icon": "$(arrow-left)"
      },
      {
        "command": "codetour.recordTour",
        "title": "%command.recordTour%",
        "category": "CodeTour",
        "icon": "$(add)"
      },
      {
        "command": "codetour.createSkills",
        "title": "%command.createSkills%",
        "category": "CodeTour"
      },
      {
        "command": "codetour.resumeTour",
        "title": "%command.resumeTour%",
        "category": "CodeTour"
      },
      {
        "command": "codetour.saveTourStep",
        "title": "%command.saveStep%",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "codetour.showMarkers",
        "title": "%command.showMarkers%",
        "category": "CodeTour",
        "icon": "$(eye)"
      },
      {
        "command": "codetour.startTour",
        "title": "%command.startTour%",
        "category": "CodeTour",
        "icon": "$(play)"
      },
      {
        "command": "codetour.unmakeTourPrimary",
        "title": "%command.unmakePrimary%"
      },
      {
        "command": "codetour.viewNotebook",
        "title": "%command.viewNotebook%",
        "category": "CodeTour"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "codetour.addContentStep",
          "when": "codetour:inTour && codetour:recording && codetour:canEditTour"
        },
        {
          "command": "codetour.endTour",
          "when": "codetour:inTour"
        },
        {
          "command": "codetour.recordTour",
          "when": "workspaceFolderCount != 0"
        },
        {
          "command": "codetour.resetProgress",
          "when": "codetour:hasProgress"
        },
        {
          "command": "codetour.resumeTour",
          "when": "codetour:inTour"
        },
        {
          "command": "codetour.startTour",
          "when": "codetour:hasTours"
        },
        {
          "command": "codetour.addDirectoryStep",
          "when": "false"
        },
        {
          "command": "codetour.addSelectionStep",
          "when": "false"
        },
        {
          "command": "codetour.addTourStep",
          "when": "false"
        },
        {
          "command": "codetour.changeTourRef",
          "when": "false"
        },
        {
          "command": "codetour.changeTourStepLine",
          "when": "false"
        },
        {
          "command": "codetour.changeTourStepTitle",
          "when": "false"
        },
        {
          "command": "codetour.changeTourStepIcon",
          "when": "false"
        },
        {
          "command": "codetour.changeTourTitle",
          "when": "false"
        },
        {
          "command": "codetour.changeTourDescription",
          "when": "false"
        },
        {
          "command": "codetour.deleteTour",
          "when": "false"
        },
        {
          "command": "codetour.deleteTourStep",
          "when": "false"
        },
        {
          "command": "codetour.editTour",
          "when": "false"
        },
        {
          "command": "codetour.editTourAtStep",
          "when": "false"
        },
        {
          "command": "codetour.exportTour",
          "when": "false"
        },
        {
          "command": "codetour.hideMarkers",
          "when": "false"
        },
        {
          "command": "codetour.makeTourPrimary",
          "when": "false"
        },
        {
          "command": "codetour.nextTourStep",
          "when": "false"
        },
        {
          "command": "codetour.previewTour",
          "when": "false"
        },
        {
          "command": "codetour.previousTourStep",
          "when": "false"
        },
        {
          "command": "codetour.resetTourProgress",
          "when": "false"
        },
        {
          "command": "codetour.saveTourStep",
          "when": "false"
        },
        {
          "command": "codetour.showMarkers",
          "when": "false"
        },
        {
          "command": "codetour.unmakeTourPrimary",
          "when": "false"
        },
        {
          "command": "codetour.viewNotebook",
          "when": "false"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "codetour.previousTourStep",
          "group": "inline@1",
          "when": "commentController == codetour && commentThread =~ /hasPrevious/"
        },
        {
          "command": "codetour.nextTourStep",
          "group": "inline@2",
          "when": "commentController == codetour && commentThread =~ /hasNext/"
        },
        {
          "command": "codetour.endTour",
          "group": "inline@3",
          "when": "commentController == codetour"
        },
        {
          "command": "codetour.editTour",
          "group": "inline@4",
          "when": "commentController == codetour && !codetour:isEditing && codetour:canEditTour"
        },
        {
          "command": "codetour.previewTour",
          "group": "inline@4",
          "when": "commentController == codetour && codetour:isEditing && !commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "codetour.addTourStep",
          "group": "inline",
          "when": "commentController == codetour && commentThreadIsEmpty"
        }
      ],
      "comments/comment/title": [
        {
          "command": "codetour.moveTourStepBack",
          "group": "move@1",
          "when": "commentController == codetour && codetour:canEditTour && commentThread =~ /hasPrevious/"
        },
        {
          "command": "codetour.moveTourStepForward",
          "group": "move@2",
          "when": "commentController == codetour && codetour:canEditTour && commentThread =~ /hasNext/"
        },
        {
          "command": "codetour.changeTourStepLine",
          "group": "mutate@1",
          "when": "commentController == codetour && codetour:canEditTour && commentThread =~ /lineAnchor/"
        },
        {
          "command": "codetour.rebindTourStepAnchor",
          "group": "mutate@1",
          "when": "commentController == codetour && codetour:canEditTour && commentThread =~ /resilientAnchor/"
        },
        {
          "command": "codetour.deleteTourStep",
          "group": "mutate@2",
          "when": "commentController == codetour && codetour:canEditTour"
        }
      ],
      "comments/comment/context": [
        {
          "command": "codetour.saveTourStep",
          "group": "inline@2",
          "when": "commentController == codetour && codetour:recording"
        }
      ],
      "view/title": [
        {
          "command": "codetour.refreshTours",
          "when": "view == codetour.tours",
          "group": "navigation@1"
        },
        {
          "command": "codetour.hideMarkers",
          "when": "view == codetour.tours && codetour:showingMarkers",
          "group": "navigation@2"
        },
        {
          "command": "codetour.showMarkers",
          "when": "view == codetour.tours && !codetour:showingMarkers",
          "group": "navigation@2"
        },
        {
          "command": "codetour.openTourFile",
          "when": "view == codetour.tours",
          "group": "navigation@3"
        },
        {
          "command": "codetour.recordTour",
          "when": "view == codetour.tours",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "codetour.endTour",
          "when": "viewItem =~ /^codetour.tour(.recording)?.active/",
          "group": "inline@2"
        },
        {
          "command": "codetour.startTour",
          "when": "viewItem =~ /^codetour.tour(.primary)?$/",
          "group": "inline@2"
        },
        {
          "command": "codetour.resumeTour",
          "when": "viewItem =~ /^codetour.tour(.primary)?(.recording)?.active$/",
          "group": "active@1"
        },
        {
          "command": "codetour.endTour",
          "when": "viewItem =~ /^codetour.tour(.primary)?(.recording)?.active$/",
          "group": "active@2"
        },
        {
          "command": "codetour.startTour",
          "when": "viewItem =~ /^codetour.tour(.primary)?$/",
          "group": "basic@1"
        },
        {
          "command": "codetour.viewNotebook",
          "when": "viewItem =~ /^codetour.tour/",
          "group": "basic@2"
        },
        {
          "command": "codetour.addContentStep",
          "when": "viewItem =~ /^codetour.tour(.primary)?.recording/",
          "group": "basic@1"
        },
        {
          "command": "codetour.resetTourProgress",
          "when": "false",
          "group": "basic@2"
        },
        {
          "command": "codetour.changeTourTitle",
          "when": "viewItem =~ /^codetour.tour(.primary)?(.recording)?(.active)?$/",
          "group": "change@1"
        },
        {
          "command": "codetour.changeTourDescription",
          "when": "viewItem =~ /^codetour.tour(.primary)?(.recording)?(.active)?$/",
          "group": "change@2"
        },
        {
          "command": "codetour.changeTourRef",
          "when": "viewItem =~ /^codetour.tour(.primary)?(.recording)?(.active)?$/ && gitOpenRepositoryCount != 0",
          "group": "change@3"
        },
        {
          "command": "codetour.makeTourPrimary",
          "when": "viewItem =~ /^codetour.tour(.recording)?(.active)?$/",
          "group": "edit@1"
        },
        {
          "command": "codetour.unmakeTourPrimary",
          "when": "viewItem =~ /^codetour.tour.primary(.recording)?(.active)?$/",
          "group": "edit@2"
        },
        {
          "command": "codetour.editTour",
          "when": "viewItem =~ /^codetour.tour(.primary)?(.active)?$/ && !codetour:recording",
          "group": "inline@1"
        },
        {
          "command": "codetour.previewTour",
          "when": "viewItem =~ /^codetour.tour(.primary)?.recording/",
          "group": "edit@2"
        },
        {
          "command": "codetour.deleteTour",
          "when": "viewItem =~ /^codetour.tour(.primary)?(.recording)?(.active)?$/",
          "group": "edit@3"
        },
        {
          "command": "codetour.exportTour",
          "when": "viewItem =~ /^codetour.tour(.primary)?(.active)?$/",
          "group": "export@1"
        },
        {
          "command": "codetour.moveTourStepBack",
          "when": "viewItem =~ /^codetour.tourStep.hasPrevious/",
          "group": "inline@1"
        },
        {
          "command": "codetour.moveTourStepForward",
          "when": "viewItem =~ /codetour.tourStep.*(.hasNext)/",
          "group": "inline@2"
        },
        {
          "command": "codetour.moveTourStepBack",
          "when": "viewItem =~ /^codetour.tourStep.hasPrevious/",
          "group": "basic@1"
        },
        {
          "command": "codetour.moveTourStepForward",
          "when": "viewItem =~ /codetour.tourStep.*(.hasNext)/",
          "group": "basic@2"
        },
        {
          "command": "codetour.changeTourStepTitle",
          "when": "viewItem =~ /^codetour.tourStep/",
          "group": "change@1"
        },
        {
          "command": "codetour.changeTourStepIcon",
          "when": "viewItem =~ /^codetour.tourStep/",
          "group": "change@2"
        },
        {
          "command": "codetour.addContentStep",
          "when": "viewItem =~ /^codetour.tourStep/ && codetour:recording",
          "group": "change@2"
        },
        {
          "command": "codetour.editTourAtStep",
          "when": "viewItem =~ /^codetour.tourStep/ && !codetour:recording && !(viewItem =~ /unresolved/)",
          "group": "manage@1"
        },
        {
          "command": "codetour.rebindTourStepAnchor",
          "when": "viewItem =~ /^codetour.tourStep.*unresolved/",
          "group": "inline@1"
        },
        {
          "command": "codetour.deleteTourStep",
          "when": "viewItem =~ /^codetour.tourStep/",
          "group": "manage@2"
        }
      ],
      "explorer/context": [
        {
          "command": "codetour.addDirectoryStep",
          "when": "codetour:recording && explorerResourceIsFolder"
        }
      ],
      "editor/context": [
        {
          "command": "codetour.addSelectionStep",
          "when": "codetour:recording && editorHasSelection",
          "group": "codetour@1"
        },
        {
          "command": "codetour.addSymbolStep",
          "when": "codetour:recording && editorHasDocumentSymbolProvider",
          "group": "codetour@2"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "codetour.tours",
          "name": "%view.title%",
          "when": "workspaceFolderCount != 0 || codetour:inTour"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codetour.tours",
        "contents": "%view.welcome%"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "*.tour",
        "url": "./schema.json"
      }
    ],
    "keybindings": [
      {
        "command": "codetour.previousTourStep",
        "when": "codetour:inTour && !textInputFocus && !terminalFocus",
        "key": "ctrl+left",
        "mac": "cmd+left"
      },
      {
        "command": "codetour.nextTourStep",
        "when": "codetour:inTour && !textInputFocus && !terminalFocus",
        "key": "ctrl+right",
        "mac": "cmd+right"
      },
      {
        "command": "codetour.endTour",
        "when": "codetour:inTour && !textInputFocus && !terminalFocus",
        "key": "ctrl+down ctrl+down",
        "mac": "cmd+down cmd+down"
      },
      {
        "command": "codetour.startTour",
        "when": "!textInputFocus && !terminalFocus",
        "key": "ctrl+up ctrl+up",
        "mac": "cmd+up cmd+up"
      }
    ],
    "languages": [
      {
        "id": "json",
        "extensions": [
          ".tour"
        ]
      }
    ],
    "notebooks": [
      {
        "type": "codetour",
        "displayName": "CodeTour",
        "selector": [
          {
            "filenamePattern": "*.tour-notebook"
          }
        ]
      }
    ]
  },
  "dependencies": {
    "@types/jexl": "^2.2.0",
    "axios": "^0.21.4",
    "jexl": "^2.3.0",
    "jsonc-parser": "^3.3.1",
    "mobx": "^5.14.2",
    "os-browserify": "0.3.0",
    "path-browserify": "1.0.1",
    "throttle-debounce": "^3.0.1",
    "vsls": "^1.0.2532"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.14.0",
    "@types/throttle-debounce": "^5.0.0",
    "@types/vscode": "^1.73.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^2.17.0",
    "debug": "^4.3.4",
    "eslint": "^8.34.0",
    "mocha": "^11.7.5",
    "ts-loader": "^9.4.2",
    "typescript": "^4.9.5",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1",
    "webpack-merge": "^5.8.0"
  },
  "scripts": {
    "build": "webpack --mode production",
    "compile-tests": "tsc -p ./tsconfig.test.json",
    "test": "npm run build && npm run compile-tests && node ./out/test/runTest.js",
    "vscode:prepublish": "npm run build",
    "watch": "webpack --mode development --watch",
    "package": "vsce package"
  },
  "prettier": {
    "arrowParens": "avoid",
    "trailingComma": "none"
  }
}
