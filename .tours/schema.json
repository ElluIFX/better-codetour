{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Schema for CodeTour tour files",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "steps"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Schema used to validate this tour file."
    },
    "title": {
      "type": "string",
      "description": "Specifies the title of the code tour."
    },
    "description": {
      "type": "string",
      "description": "Specifies an optional description for the code tour."
    },
    "ref": {
      "type": "string",
      "description": "Indicates the git ref that this tour is associated with."
    },
    "isPrimary": {
      "type": "boolean",
      "description": "Specifies whether the tour represents the primary tour for this codebase."
    },
    "steps": {
      "type": "array",
      "description": "Specifies the ordered steps in the code tour.",
      "default": [],
      "items": {
        "$ref": "#/definitions/step"
      }
    },
    "nextTour": {
      "type": "string",
      "description": "Specifies the title of the tour that follows this tour."
    },
    "when": {
      "type": "string",
      "description": "Specifies the condition that must be met before this tour is shown."
    }
  },
  "definitions": {
    "symbolPathSegment": {
      "type": "object",
      "required": ["name", "kind"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Symbol name reported by the document symbol provider."
        },
        "kind": {
          "description": "Canonical VS Code SymbolKind name. Integer values are accepted for compatibility and normalized on save.",
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "File",
                "Module",
                "Namespace",
                "Package",
                "Class",
                "Method",
                "Property",
                "Field",
                "Constructor",
                "Enum",
                "Interface",
                "Function",
                "Variable",
                "Constant",
                "String",
                "Number",
                "Boolean",
                "Array",
                "Object",
                "Key",
                "Null",
                "EnumMember",
                "Struct",
                "Event",
                "Operator",
                "TypeParameter"
              ]
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 25
            }
          ]
        }
      }
    },
    "anchor": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "number"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "line"
            },
            "number": {
              "type": "integer",
              "minimum": 1,
              "description": "One-based source line number."
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "path"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "symbol"
            },
            "path": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/definitions/symbolPathSegment"
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "text"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "content"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "description": "Literal selected source text, normalized to LF line endings."
            }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "required": ["description"],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["file", "anchor"],
          "not": {
            "anyOf": [
              { "required": ["directory"] },
              { "required": ["uri"] },
              { "required": ["view"] }
            ]
          }
        },
        {
          "required": ["directory"],
          "not": {
            "anyOf": [
              { "required": ["file"] },
              { "required": ["anchor"] },
              { "required": ["contents"] },
              { "required": ["uri"] },
              { "required": ["view"] }
            ]
          }
        },
        {
          "required": ["uri"],
          "not": {
            "anyOf": [
              { "required": ["file"] },
              { "required": ["anchor"] },
              { "required": ["contents"] },
              { "required": ["directory"] },
              { "required": ["view"] }
            ]
          }
        },
        {
          "required": ["view"],
          "not": {
            "anyOf": [
              { "required": ["file"] },
              { "required": ["anchor"] },
              { "required": ["contents"] },
              { "required": ["directory"] },
              { "required": ["uri"] }
            ]
          }
        },
        {
          "not": {
            "anyOf": [
              { "required": ["file"] },
              { "required": ["anchor"] },
              { "required": ["contents"] },
              { "required": ["directory"] },
              { "required": ["uri"] },
              { "required": ["view"] }
            ]
          }
        }
      ],
      "properties": {
        "file": {
          "type": "string",
          "description": "Workspace-relative source file associated with the step."
        },
        "directory": {
          "type": "string",
          "description": "Workspace-relative directory associated with the step."
        },
        "contents": {
          "type": "string",
          "description": "Embedded file contents associated with the step."
        },
        "view": {
          "type": "string",
          "minLength": 1,
          "description": "View ID associated with the step."
        },
        "uri": {
          "type": "string",
          "description": "Absolute URI associated with the step."
        },
        "anchor": {
          "$ref": "#/definitions/anchor"
        },
        "title": {
          "type": "string",
          "description": "Optional title for the step."
        },
        "icon": {
          "type": "string",
          "description": "Optional icon for the step."
        },
        "description": {
          "type": "string",
          "description": "Description of the step."
        },
        "commands": {
          "type": "array",
          "description": "Command URIs executed when the step is opened.",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
